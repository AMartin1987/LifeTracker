<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:LifeTracker.ViewModels"
             x:Class="LifeTracker.ActivitiesPage"
             Title="Mis Actividades">

    <!-- Enlazamos esta vista con su ViewModel correspondiente -->
    <ContentPage.BindingContext>
        <viewmodels:ActivitiesViewModel />
    </ContentPage.BindingContext>

    <!-- Usamos un Grid para dividir la pantalla: Una fila para el input, otra para la lista -->
    <Grid RowDefinitions="Auto, *" Padding="20">

        <!-- === SECCIÓN SUPERIOR: Input para agregar actividad === -->
        <HorizontalStackLayout Grid.Row="0" Spacing="10" Margin="0,0,0,20">
            <Entry Placeholder="Ej: Entrenando Poderes Evol..." 
                   Text="{Binding NewActivityName}"
                   WidthRequest="250" />

            <Button Text="Agregar" 
                    Command="{Binding AddActivityCommand}" />
        </HorizontalStackLayout>


        <!-- === SECCIÓN INFERIOR: Lista de actividades guardadas === -->
        <CollectionView Grid.Row="1" ItemsSource="{Binding ActivitiesList}">

            <CollectionView.ItemTemplate>
                <DataTemplate>

                    <!-- Tarjeta para cada actividad -->
                    <Frame Margin="0,0,0,10" Padding="15" CornerRadius="8" HasShadow="True">

                        <Grid ColumnDefinitions="*, Auto">
                            <!-- Nombre de la actividad a la izquierda -->
                            <Label Text="{Binding Name}" 
                                   VerticalOptions="Center" 
                                   FontSize="16" />

                            <!-- Botón de seleccionar a la derecha -->
                            <!-- Este Binding es especial porque el comando está en el ViewModel padre -->
                            <Button Grid.Column="1" 
                                    Text="Seleccionar" 
                                    Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodels:ActivitiesViewModel}}, Path=SelectActivityCommand}"
                                    CommandParameter="{Binding .}" />
                        </Grid>

                    </Frame>

                </DataTemplate>
            </CollectionView.ItemTemplate>

        </CollectionView>

    </Grid>
</ContentPage>