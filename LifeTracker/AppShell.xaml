<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="LifeTracker.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:LifeTracker"
    xmlns:views="clr-namespace:LifeTracker.Views"
    Shell.FlyoutBehavior="Disabled"
    Shell.TabBarIsVisible="False">

    <TabBar>
        <Tab Route="MainPage">
            <ShellContent ContentTemplate="{DataTemplate views:MainPage}" />
        </Tab>

        <Tab Route="ActivitiesPage">
            <ShellContent ContentTemplate="{DataTemplate views:ActivitiesPage}" />
        </Tab>

        <Tab Route="HistoryPage">
            <ShellContent ContentTemplate="{DataTemplate views:HistoryPage}" />
        </Tab>
    </TabBar>

</Shell>