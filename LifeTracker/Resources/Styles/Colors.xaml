<?xml version="1.0" encoding="UTF-8" ?>
<ResourceDictionary 
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <Color x:Key="WinGray">#C0C0C0</Color>
    <Color x:Key="WinDarkGray">#808080</Color>
    <Color x:Key="MainLavender">#9D9DCC</Color>
    <Color x:Key="WinNavy">#000080</Color>
    <Color x:Key="WinTeal">#64A9A7</Color>

    <Color x:Key="White">#FFFFFF</Color>
    <Color x:Key="Black">#000000</Color>

    <Color x:Key="Primary">#575799</Color>
    <Color x:Key="Secondary">#64A9A7</Color> 

    <Color x:Key="Gray100">#FFFFFF</Color>
    <Color x:Key="Gray200">#C0C0C0</Color>
    <Color x:Key="Gray300">#C0C0C0</Color>
    <Color x:Key="Gray400">#808080</Color>
    <Color x:Key="Gray500">#808080</Color>
    <Color x:Key="Gray600">#808080</Color>
    <Color x:Key="Gray900">#000000</Color>
    <Color x:Key="Gray950">#000000</Color>

    <SolidColorBrush x:Key="WinGrayBrush" Color="{StaticResource WinGray}"/>
    <SolidColorBrush x:Key="WhiteBrush" Color="{StaticResource White}"/>
    <SolidColorBrush x:Key="BlackBrush" Color="{StaticResource Black}"/>
</ResourceDictionary>